# ./srcs/frontend/Dockerfile
FROM node:bookworm-slim

ARG FRONTEND_PORT=5173
ARG BACKEND_PORT
ARG BACKEND_BASE

ENV NODE_ENV=development
ENV FRONTEND_PORT=${FRONTEND_PORT}
ENV PUBLIC_BACKEND_PORT=${BACKEND_PORT}
ENV PUBLIC_BACKEND_BASE=${BACKEND_BASE}

WORKDIR /usr/src/frontend

# deps first for caching
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile

# app files
COPY . .

# install browser once (Chromium) for Playwright/Vitest Browser
RUN npx playwright install --with-deps chromium

# optional: pre-build (you asked earlier to build before dev)
RUN yarn run build

EXPOSE ${FRONTEND_PORT}

# default: run the dev server
CMD ["sh", "-lc", "yarn install && yarn run build"]
